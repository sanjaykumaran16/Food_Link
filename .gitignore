# ========================
# Root-level .gitignore
# ========================
# Each sub-project (backend/, frontend/) has its own .gitignore.
# This root file catches anything that slips through at the repo level.

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
build/

# Logs
logs/
*.log
*.csv

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime
pids/
*.pid
*.seed
